rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // pillar 0: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // GLOBAL HELPERS
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // v10.3: tài khoản bị khoá (users/{uid}.isBlocked == true) không được đọc/ghi dữ liệu.
    // Riêng tài liệu users/{uid} của chính mình vẫn đọc được (isSelf) để giao diện hiện thông báo bị khoá.
    function notBlocked() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBlocked', false) != true;
    }

    function isActiveUser() {
      return isSignedIn() && notBlocked();
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwner(userId) {
      return isSelf(userId) && notBlocked();
    }

    // v10.3: chỉ tin email trong token khi email đã được XÁC MINH (chặn đăng ký email/mật khẩu giả email người khác)
    function hasVerifiedEmail() {
      return request.auth != null &&
             'email' in request.auth.token && request.auth.token.email is string &&
             'email_verified' in request.auth.token && request.auth.token.email_verified == true;
    }

    function verifiedEmail() {
      return hasVerifiedEmail() ? request.auth.token.email.lower() : '';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == "4cFbfQhPMpgStJXZ9EpAVcd90i33" ||
        (hasVerifiedEmail() && request.auth.token.email.lower() == "hoanghiep1296@gmail.com") ||
        (hasVerifiedEmail() && request.auth.token.email.lower() == "mrihachnach@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // v10.3: chỉ chấp nhận email đã xác minh + người dùng không bị khoá
    function isSharedWithMe(data) {
      let email = verifiedEmail();
      return request.auth != null && email != "" && notBlocked() && (
        data.get('sharedWith', []).hasAny([email])
      );
    }

    // v10.3: downloadUrl chỉ được là liên kết Google Drive / Firebase Storage (https) hoặc rỗng
    function isSafeDownloadUrl(url) {
      return url == '' ||
             url.matches('^https://(drive|docs)[.]google[.]com/.*') ||
             url.matches('^https://firebasestorage[.]googleapis[.]com/.*') ||
             url.matches('^https://storage[.]googleapis[.]com/.*');
    }

    // ===============================================================
    // VALIDATION HELPERS
    // ===============================================================

    function isValidUser(data) {
      let userEmail = (request.auth != null && 'email' in request.auth.token && request.auth.token.email is string) ? request.auth.token.email.lower() : '';
      return (isAdmin() || (data.uid == request.auth.uid && (data.get('email', null) == null || data.email.lower() == userEmail))) &&
             (data.get('role', 'user') in ['user', 'admin']) &&
             (data.get('displayName', null) == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (data.get('photoURL', null) == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
             (data.get('level', 1) is number) &&
             (data.get('levelExpiresAt', null) == null || data.levelExpiresAt is timestamp || data.levelExpiresAt is string) &&
             (data.get('isBlocked', false) is bool) &&
             (data.get('createdAt', null) == null || data.createdAt is timestamp || data.createdAt is string);
    }

    function isValidUserResource(data) {
       return data.keys().hasAll(['uid', 'email', 'role']);
    }

    function isValidDocument(data) {
      return data.keys().hasAll(['name', 'ownerId', 'downloadUrl', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 256 &&
             data.ownerId is string &&
             data.downloadUrl is string && data.downloadUrl.size() <= 2048 &&
             (data.createdAt is timestamp || data.createdAt is string) &&
             (data.get('sharedWith', []) is list) && data.get('sharedWith', []).size() <= 50 &&
             (data.get('size', 0) is number) &&
             (data.get('type', '') is string) &&
             (data.get('token', null) == null || (data.token is string && data.token.size() <= 128)) &&
             (data.get('driveFileId', null) == null || (data.driveFileId is string && data.driveFileId.size() <= 128));
    }

    function isValidFolder(data) {
      return data.keys().hasAll(['name', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             (data.createdAt is timestamp || data.createdAt is string) &&
             (data.get('parentId', null) == null || isValidId(data.parentId));
    }

    function isValidApiKey(data) {
      return data.keys().hasAll(['ownerId', 'name', 'value', 'engine', 'createdAt']) &&
             data.ownerId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.value is string && data.value.size() > 0 && data.value.size() <= 4096 &&
             data.engine is string && data.engine.size() > 0 && data.engine.size() <= 128 &&
             (data.createdAt is timestamp || data.createdAt is string) &&
             (data.get('lastUsed', null) == null || data.lastUsed is timestamp || data.lastUsed is string) &&
             (data.get('updatedAt', null) == null || data.updatedAt is timestamp || data.updatedAt is string) &&
             (data.get('ownerEmail', null) == null || data.ownerEmail is string) &&
             (data.get('sharedWith', []) is list) && data.get('sharedWith', []).size() <= 50 &&
             (data.get('status', 'active') in ['active', 'error']);
    }

    function isValidTranslation(data) {
      return data.keys().hasAll(['content', 'status', 'updatedAt']) &&
             data.content is string && data.content.size() <= 1048576 &&
             data.status in ['success', 'error', 'loading'] &&
             (data.updatedAt is timestamp || data.updatedAt is string);
    }

    // Bản dịch giữ định dạng: lưu cặp {s: câu gốc, v: câu dịch} của từng khối chữ trên trang
    function isValidLayoutPage(data) {
      return data.keys().hasAll(['pairs', 'updatedAt']) &&
             data.pairs is list && data.pairs.size() <= 3000 &&
             (data.updatedAt is timestamp || data.updatedAt is string) &&
             (data.get('version', 1) is number);
    }

    function isValidSummary(data) {
      return data.keys().hasAll(['content', 'type', 'createdAt']) &&
             data.content is string && data.content.size() <= 1048576 &&
             data.type in ['page', 'chapter', 'document', 'range'] &&
             (data.createdAt is timestamp || data.createdAt is string) &&
             (data.get('range', '') is string);
    }

    function isValidBlacklist(data) {
      return data.keys().hasAll(['email', 'reason', 'createdAt']) &&
             data.email is string &&
             data.reason is string &&
             (data.createdAt is timestamp || data.createdAt is string);
    }

    // ===============================================================
    // RESOURCES
    // ===============================================================

    match /users {
      allow list: if isAdmin();
    }

    match /users/{userId} {
      allow list: if isAdmin();
      // v10.3: isSelf (không xét isBlocked) để người bị khoá vẫn đọc được trạng thái của mình
      allow get: if isSelf(userId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(userId) && 
        isValidUser(incoming()) && 
        isValidUserResource(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().get('role', 'user') == 'user' &&
        incoming().get('level', 1) == 1 &&
        (!('levelExpiresAt' in incoming()) || incoming().levelExpiresAt == null) &&
        incoming().get('isBlocked', false) == false
      );
      allow update: if isAdmin() || (
        isOwner(userId) && 
        isValidUser(incoming()) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])
      );
      allow delete: if isAdmin();
      
      match /folders/{folderId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidFolder(incoming()) && isValidId(folderId);
        allow update: if (isOwner(userId) && isValidFolder(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'parentId'])) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /documents/{docId} {
        allow get: if isOwner(userId) || isSharedWithMe(existing()) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        // v10.3: ownerId phải đúng chủ thư mục + downloadUrl an toàn
        allow create: if isOwner(userId) && isValidDocument(incoming()) && isValidId(docId) &&
                         incoming().ownerId == userId && isSafeDownloadUrl(incoming().downloadUrl);
        allow update: if (isOwner(userId) && isValidDocument(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'folderId', 'sharedWith'])) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();

        match /pages/{pageNum} {
          allow read: if isOwner(userId) || isSharedWithMe(get(/databases/$(database)/documents/users/$(userId)/documents/$(docId)).data) || isAdmin();
          allow write: if (isOwner(userId) || isAdmin()) && isValidTranslation(incoming());
        }

        match /layoutPages/{pageNum} {
          allow read: if isOwner(userId) || isSharedWithMe(get(/databases/$(database)/documents/users/$(userId)/documents/$(docId)).data) || isAdmin();
          allow create, update: if (isOwner(userId) && isValidLayoutPage(incoming())) || isAdmin();
          allow delete: if isOwner(userId) || isAdmin();
        }

        match /summaries/{summaryId} {
          allow read: if isOwner(userId) || isSharedWithMe(get(/databases/$(database)/documents/users/$(userId)/documents/$(docId)).data) || isAdmin();
          allow write: if (isOwner(userId) && isValidSummary(incoming())) || isAdmin();
        }
      }
    }

    match /apiKeys/{keyId} {
      // v10.3: email chia sẻ phải đã xác minh; người bị khoá không dùng được; ownerId bất biến khi cập nhật
      allow get: if isSignedIn() && ((isActiveUser() && existing().ownerId == request.auth.uid) || isSharedWithMe(existing()) || isAdmin());
      allow list: if isSignedIn() && ((isActiveUser() && resource.data.ownerId == request.auth.uid) || isSharedWithMe(resource.data) || isAdmin());
      allow create: if isSignedIn() && ((isActiveUser() && incoming().ownerId == request.auth.uid) || isAdmin()) && isValidApiKey(incoming());
      allow update: if (isSignedIn() && ((isActiveUser() && existing().ownerId == request.auth.uid) || isAdmin()) &&
                        isValidApiKey(incoming()) && incoming().ownerId == existing().ownerId);
      allow delete: if (isSignedIn() && ((isActiveUser() && existing().ownerId == request.auth.uid) || isAdmin()));
    }

    // v10.4: lượng dùng AI hệ thống (máy chủ ghi bằng Admin SDK); người dùng chỉ xem được của mình
    match /aiUsage/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /systemShopAiKeys/{keyId} {
      allow read, write: if isAdmin();
    }

    match /blacklist/{email} {
      allow get: if isSignedIn() && (('email' in request.auth.token && request.auth.token.email == email) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidBlacklist(incoming());
      allow delete: if isAdmin();
    }

    // Collection Group for Shared Documents
    match /{path=**}/documents/{docId} {
      allow list: if isSharedWithMe(resource.data) || isAdmin();
    }

    // System/Debug
    match /test_connection/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /test/{docId} {
      allow read: if docId == 'connection' || isSignedIn();
      allow write: if isAdmin();
    }
  }
}
